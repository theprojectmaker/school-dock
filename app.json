{
  "expo": {
    "name": "School Dock",
    "slug": "school-dock",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "schooldock",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.solyapps.schooldock",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "School Dock",
        "UIStatusBarHidden": false
      }
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "School Dock opens the photos you pick: a wallpaper, or pages for a note.",
          "cameraPermission": "Quill uses the camera to scan paper notes and worksheets."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1020",
          "image": "./assets/icon.png",
          "imageWidth": 110
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "522c4d33-eeb3-4155-a90b-b31f86f98707"
      }
    },
    "owner": "solomonsasson"
  }
}
